VITE_API_URL=

# Origen público del sitio (sin barra final). Vite lo sustituye en index.html
# para canonical, Open Graph y JSON-LD. Si no se define, esas etiquetas quedan
# con el literal %VITE_PUBLIC_URL% y los previews de enlaces se rompen.
VITE_PUBLIC_URL=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_NODE_ENV=development
